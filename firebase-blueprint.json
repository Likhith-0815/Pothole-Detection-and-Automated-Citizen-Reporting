{
  "entities": {
    "Incident": {
      "title": "Incident",
      "description": "GVMC Road defect / pothole complaint incident record",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "locationName": { "type": "string", "maxLength": 200 },
        "ward": { "type": "string", "maxLength": 100 },
        "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
        "priorityScore": { "type": "number" },
        "confidence": { "type": "number" },
        "surfaceAreaM2": { "type": "number" },
        "estimatedDepthCm": { "type": "number" },
        "estimatedCostINR": { "type": "number" },
        "imageUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["REPORTED", "AI_ANALYZED", "DISPATCHED", "IN_REPAIR", "RESOLVED"] },
        "reportedAt": { "type": "string" },
        "assignedCrewId": { "type": "string" },
        "assignedCrewName": { "type": "string" }
      },
      "required": ["title", "locationName", "ward", "severity", "status", "reportedAt"]
    },
    "FleetCrew": {
      "title": "FleetCrew",
      "description": "GVMC Municipal repair fleet crew unit",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "leader": { "type": "string", "maxLength": 100 },
        "contact": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["AVAILABLE", "EN_ROUTE", "ON_SITE", "MAINTENANCE"] },
        "currentLocation": { "type": "string", "maxLength": 200 },
        "assignedWard": { "type": "string", "maxLength": 100 },
        "jobsCompletedToday": { "type": "number" }
      },
      "required": ["name", "status", "assignedWard"]
    },
    "User": {
      "title": "User",
      "description": "User profile with role details",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["citizen", "engineer", "admin"] },
        "name": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Registered municipal and citizen user profiles"
    },
    "/incidents/{incidentId}": {
      "schema": { "$ref": "#/entities/Incident" },
      "description": "Road defects and pothole complaints collection"
    },
    "/crews/{crewId}": {
      "schema": { "$ref": "#/entities/FleetCrew" },
      "description": "Municipal repair crew fleet collection"
    }
  }
}
